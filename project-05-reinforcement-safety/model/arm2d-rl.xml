<mujoco model="horizontal two-link continuous RL">
  <compiler angle="radian"/>
  <option timestep="0.004" integrator="implicitfast" gravity="0 0 -9.81"/>
  <visual><global offwidth="640" offheight="480"/></visual>
  <default>
    <joint type="hinge" axis="0 0 1" damping="0.5" armature="0.08" limited="false"/>
    <geom type="capsule" size="0.025" contype="0" conaffinity="0"/>
    <motor ctrllimited="true" ctrlrange="-6 6"/>
  </default>
  <worldbody>
    <light pos="0 0 3"/>
    <geom name="floor" type="plane" size="2 2 0.01" rgba="0.9 0.95 0.94 1"/>
    <body name="base" pos="0 0 0.10">
      <geom type="cylinder" size="0.07 0.08" rgba="0.1 0.3 0.3 1"/>
      <body name="link1">
        <joint name="q1"/>
        <geom fromto="0 0 0 0.6 0 0" mass="1.2" rgba="0.05 0.6 0.6 1"/>
        <body name="link2" pos="0.6 0 0">
          <joint name="q2"/>
          <geom fromto="0 0 0 0.4 0 0" mass="0.8" rgba="0.15 0.35 0.7 1"/>
          <site name="tip" pos="0.4 0 0" size="0.035" rgba="0.9 0.65 0.1 1"/>
        </body>
      </body>
    </body>
    <body name="target" mocap="true" pos="0.55 0.4 0.10">
      <geom type="sphere" size="0.04" rgba="0.9 0.45 0.05 0.6"/>
    </body>
  </worldbody>
  <actuator><motor joint="q1"/><motor joint="q2"/></actuator>
</mujoco>
